# ─────────────────────────────────────────────────────────────────────────────
# MolePin contracts — environment variables example.
# Copy to `.env` and fill in your values. NEVER commit your real `.env`.
#
# MolePin 컨트랙트용 환경 변수 예시. `.env`로 복사 후 값을 채우세요.
# 실제 `.env`는 절대 커밋하지 마세요.
#
# Home chain = BSC. Remote chains = Polygon / Base / Arbitrum / Optimism / ...
# (KO: 홈 체인 = BSC. 리모트 = Polygon/Base/Arbitrum/Optimism 등.)
# ─────────────────────────────────────────────────────────────────────────────

# ── RPC endpoints ────────────────────────────────────────────────────────────
# Public RPCs work but are rate-limited. Use Alchemy/Infura/QuickNode for prod.
# 공용 RPC는 동작하지만 rate-limit이 있습니다. 운영에는 Alchemy/Infura/QuickNode 권장.
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
POLYGON_RPC_URL=https://polygon-rpc.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io

# ── Deployer key ─────────────────────────────────────────────────────────────
# 0x-prefixed private key. NEVER commit your real key. Use a fresh key
# funded with only what you need to deploy.
# 0x로 시작하는 프라이빗 키. 절대 커밋 금지. 배포에 필요한 만큼만 가스가
# 들어 있는 신규 키 사용 권장.
DEPLOYER_PRIVATE_KEY=

# ── Treasury (fee recipient) ─────────────────────────────────────────────────
# Wallet that receives the MolePin bridge fee (native gas token).
# MolePin 멀티체인 수수료(native 가스토큰)를 받는 지갑(배포지갑).
TREASURY_ADDRESS=

# ── Block-explorer API keys (for `hardhat verify`) ───────────────────────────
# 컨트랙트 verify용 API 키. BscScan이 주 체인.
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
OPSCAN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Chainlink CCIP — per chain (Router / chainSelector / RMN). See DEPLOY_NOTES.md.
# 배포 직전 공식 디렉토리에서 재확인: https://docs.chain.link/ccip/directory
# ─────────────────────────────────────────────────────────────────────────────

# ── BSC Testnet CCIP (verified) ──────────────────────────────────────────────
CCIP_ROUTER_BSC_TESTNET=0xE1053aE1857476f36A3C62580FF9b016E8EE8F6f
CCIP_CHAIN_SELECTOR_BSC_TESTNET=13264668187771770619
CCIP_RMN_BSC_TESTNET=0xA8C0c11bf64AF62CDCA6f93D3769B88BdD7cb93D
CCIP_TOKEN_ADMIN_REGISTRY_BSC_TESTNET=0xF8f2A4466039Ac8adf9944fD67DBb3bb13888f2B
CCIP_REGISTRY_MODULE_OWNER_BSC_TESTNET=0x8Cd87FeAC14D69D770E67Bedf029e6fd3F33D0C7
LINK_BSC_TESTNET=0x84b9B910527Ad5C03A9Ca831909E21e236EA7b06

# ── BSC Mainnet CCIP (confirm before deploy) ─────────────────────────────────
# https://docs.chain.link/ccip/directory/mainnet/chain/bsc-mainnet
CCIP_ROUTER_BSC=
CCIP_CHAIN_SELECTOR_BSC=
CCIP_RMN_BSC=
CCIP_TOKEN_ADMIN_REGISTRY_BSC=
CCIP_REGISTRY_MODULE_OWNER_BSC=

# ─────────────────────────────────────────────────────────────────────────────
# Chainlink native-token/USD price feeds — per chain.
# ⚠ Inject the SOURCE chain's gas-token feed into the gateway's `nativeUsdFeed`.
#   Polygon gas is POL (NOT ETH) -> use POL/USD. Wrong feed = huge mispricing.
# ⚠ 게이트웨이 nativeUsdFeed에는 그 체인 가스토큰/USD를 넣을 것.
#   Polygon은 POL/USD (ETH/USD 넣으면 수천배 오차).
# ─────────────────────────────────────────────────────────────────────────────

# BNB/USD
CHAINLINK_BNB_USD_BSC=0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE
CHAINLINK_BNB_USD_BSC_TESTNET=0x2514895c72f50D8bd4B4F9b1110F0D6bD2c97526

# POL/USD (Polygon gas token)
CHAINLINK_POL_USD_POLYGON=0xAB594600376Ec9fD91F8e885dADF0CE036862dE0
CHAINLINK_POL_USD_AMOY=0x001382149eBa3441043c1c66972b4772963f5D43

# ETH/USD (Ethereum / Base / Arbitrum / Optimism gas token)
CHAINLINK_ETH_USD_ETHEREUM=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
CHAINLINK_ETH_USD_BASE=
CHAINLINK_ETH_USD_ARBITRUM=
CHAINLINK_ETH_USD_OPTIMISM=
